{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "command": "node .agents/gate.mjs \"$FILE_PATH\" --auto-ground"
      }
    ],
    "Stop": [
      {
        "command": "node .agents/stop-gate.mjs"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "type": "command",
        "command": "node .agents/post-tool.mjs"
      }
    ]
  }
}