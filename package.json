{
  "name": "rn-terrain",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "The live intelligence layer for the React Native ecosystem.",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "check-types": "pnpm -r run check-types",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "pnpm -r run clean",
    "deps:check": "pnpm dlx taze -r",
    "deps:audit": "pnpm dlx taze major -r --no-node-version",
    "deps:upgrade": "pnpm dlx taze -r -w && pnpm install",
    "deps:upgrade:major": "pnpm dlx taze major -r -w && pnpm install",
    "atlas:dev": "pnpm --filter github-atlas dev",
    "atlas:build": "pnpm --filter github-atlas build",
    "atlas:collect": "pnpm --filter github-atlas collect"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3"
  }
}
