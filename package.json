{
  "name": "rn-terrain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The live intelligence layer for the React Native ecosystem.",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "check-types": "pnpm -r run check-types",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "pnpm -r run clean",
    "atlas:dev": "pnpm --filter github-atlas dev",
    "atlas:build": "pnpm --filter github-atlas build",
    "atlas:collect": "pnpm --filter github-atlas collect"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
