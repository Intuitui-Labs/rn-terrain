{
  "name": "@intuitui-labs/openeval",
  "version": "0.2.1",
  "description": "Transparent, participatory evaluation and recommendation framework for complex ecosystems and catalog intelligence.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ingestion": {
      "types": "./dist/ingestion.d.ts",
      "import": "./dist/ingestion.js",
      "default": "./dist/ingestion.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --build --noEmit",
    "test": "vitest run",
    "clean": "node -e \"fs.rmSync('.turbo',{recursive:true,force:true}); fs.rmSync('node_modules',{recursive:true,force:true}); fs.rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "pnpm run check-types && pnpm run test && pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/intuitui-labs/rn-terrain.git",
    "directory": "packages/openeval-core"
  },
  "keywords": [
    "evaluation",
    "framework",
    "scoring",
    "recommendations",
    "ecosystem",
    "decision-matrix",
    "provenance"
  ],
  "author": "Intuitui Labs",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
