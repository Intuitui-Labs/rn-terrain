{
  "name": "@intuitui-labs/rn-terrain-core",
  "version": "0.4.0",
  "description": "Core intelligence, architectural health signals, vitality algorithms, and schema models for the React Native ecosystem.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "import": "./dist/db.js",
      "default": "./dist/db.js"
    },
    "./queries": {
      "types": "./dist/queries.d.ts",
      "import": "./dist/queries.js",
      "default": "./dist/queries.js"
    },
    "./radar": {
      "types": "./dist/radar.d.ts",
      "import": "./dist/radar.js",
      "default": "./dist/radar.js"
    },
    "./scoring": {
      "types": "./dist/scoring/index.d.ts",
      "import": "./dist/scoring/index.js",
      "default": "./dist/scoring/index.js"
    },
    "./sync-daily": {
      "types": "./dist/sync-daily.d.ts",
      "import": "./dist/sync-daily.js",
      "default": "./dist/sync-daily.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "default": "./dist/types/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --build --noEmit",
    "clean": "node -e \"fs.rmSync('.turbo',{recursive:true,force:true}); fs.rmSync('node_modules',{recursive:true,force:true}); fs.rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "pnpm run check-types && pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/intuitui-labs/rn-terrain.git",
    "directory": "packages/core"
  },
  "keywords": [
    "react-native",
    "expo",
    "rn-terrain",
    "ecosystem",
    "new-architecture",
    "turbomodules",
    "fabric",
    "vitest5"
  ],
  "author": "Intuitui Labs",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "semver": "^7.8.5",
    "yaml": "^2.9.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "catalog:",
    "@types/semver": "^7.8.0",
    "typescript": "catalog:"
  }
}
