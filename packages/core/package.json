{
  "name": "@rn-terrain/core",
  "version": "0.0.1",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*",
      "import": "./src/*",
      "default": "./src/*"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "check-types": "pnpm exec tsc --build --noEmit",
    "clean": "node -e \"fs.rmSync('.turbo',{recursive:true,force:true}); fs.rmSync('node_modules',{recursive:true,force:true}); fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@supabase/supabase-js": "2.102.1",
    "dotenv": "^17.4.2",
    "semver": "^7.8.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/semver": "^7.7.1",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2"
  }
}
