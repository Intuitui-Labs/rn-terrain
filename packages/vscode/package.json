{
  "name": "@intuitui-labs/rn-terrain-vscode",
  "private": true,
  "displayName": "RN Terrain",
  "description": "Visual React Native package intelligence, compatibility, and version checks directly inside package.json.",
  "version": "0.1.0",
  "publisher": "intuitui-labs",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "check-types": "tsc --build --noEmit",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "@intuitui-labs/rn-terrain-core": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.137.0",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}

