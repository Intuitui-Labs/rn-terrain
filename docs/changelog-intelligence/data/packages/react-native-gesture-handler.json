    "legacy_component_handlers": {
      "display": "Legacy Component Handlers (<PanGestureHandler>, <TapGestureHandler>)",
      "transition_milestones": {
        "experimental": null,
        "added": "1.0.0",
        "deprecated": "2.0.0",
        "removed": "3.0.0"
      },
      "rules": {
        "banned_import": "PanGestureHandler, TapGestureHandler, LongPressGestureHandler, PinchGestureHandler",
        "replacement": "GestureDetector with Gesture.Pan() or v3 hooks"
      },
      "code_smell": "<(Pan|Tap|LongPress|Pinch|Rotation)GestureHandler",
      "impact_severity": "CRITICAL"
    },
    "modal_nested_root_view_disconnection": {
      "display": "React Native Modal touch context disconnection on Android",
      "transition_milestones": {
        "experimental": null,
        "added": "2.0.0",
        "deprecated": null,
        "removed": null
      },
      "rules": {
        "replaces_custom_code": "Manual touch listeners or touch passthrough hacks in Android modals",
        "benefit": "Wrapping modal content in GestureHandlerRootView restores native gesture context"
      },
      "code_smell": "<Modal[\\s\\S]*?>\\s*<(?!GestureHandlerRootView)",
      "impact_severity": "HIGH"
    },
