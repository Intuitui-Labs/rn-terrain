        "experimental": null,
        "added": "2.5.0",
        "deprecated": null,
        "removed": null
      },
      "rules": {
        "benefit": "Enables simultaneousWithExternalGesture coordination without outer scroll view stealing touches"
      },
      "impact_severity": "OPPORTUNITY"
    },
